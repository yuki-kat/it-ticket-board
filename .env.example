# Settings for docker-compose.yml. Copy this file to .env and fill it in (.env is ignored by git).

# Database password. Letters and numbers only, because it goes into a connection URL:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs sign-in tokens. Long and random; the server refuses to start without it:
#   openssl rand -base64 48
JWT_SECRET=

# Optional: enables Find resolution (AI-suggested fixes). Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: lets a system admin save their own AI provider keys (Gemini, OpenAI, Azure OpenAI, Anthropic or an
# OpenAI-compatible server) in Tools → AI providers. Keys are encrypted with this; changing it means re-entering them:
#   openssl rand -base64 48
AI_KEYS_SECRET=
# Set to true to allow providers on your own network or plain http, e.g. Ollama at http://host.docker.internal:11434/v1
AI_ALLOW_PRIVATE_ENDPOINTS=false

# Where the board listens. 127.0.0.1 = this machine only; 0.0.0.0 = your network (put HTTPS in front first).
WEB_BIND=127.0.0.1
WEB_PORT=8080
# The address people type into the browser.
PUBLIC_URL=http://localhost:8080
