NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DATABASE_URL=postgresql://ticket_user:ticket_pass@localhost:5432/ticket_board
REDIS_URL=redis://localhost:6379

JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

CORS_ORIGIN=http://localhost:5173

# AI Features: Get a real Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: models to try in order (comma-separated). Defaults to gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
